source leaprc.protein.ff14SB
source leaprc.water.tip3p
protein = loadpdb protein-input.pdb
saveamberparm protein protein-reference.prmtop protein-reference.inpcrd
addAtomTypes { { "OY" "O" "sp3" } { "O3" "O" "sp2" } }
