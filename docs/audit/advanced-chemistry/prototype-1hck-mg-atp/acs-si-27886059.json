{"files": [{"id": 50698206, "name": "ct4c01142_si_001.pdf", "size": 731088, "is_link_only": false, "download_url": "https://ndownloader.figshare.com/files/50698206", "supplied_md5": "17c8f06e859b14f65068cbaa2d58fae5", "computed_md5": "17c8f06e859b14f65068cbaa2d58fae5", "mimetype": "application/pdf"}], "folder_structure": {}, "authors": [{"id": 13227255, "full_name": "Fangchen Hu", "first_name": "Fangchen", "last_name": "Hu", "is_active": false, "url_name": "_", "orcid_id": ""}, {"id": 388956, "full_name": "Yuwei Zhang", "first_name": "Yuwei", "last_name": "Zhang", "is_active": false, "url_name": "_", "orcid_id": ""}, {"id": 290581, "full_name": "Pengfei Li", "first_name": "Pengfei", "last_name": "Li", "is_active": false, "url_name": "_", "orcid_id": ""}, {"id": 1374138, "full_name": "Ruibo Wu", "first_name": "Ruibo", "last_name": "Wu", "is_active": false, "url_name": "_", "orcid_id": ""}, {"id": 256985, "full_name": "Fei Xia", "first_name": "Fei", "last_name": "Xia", "is_active": false, "url_name": "_", "orcid_id": ""}], "custom_fields": [], "figshare_url": "https://acs.figshare.com/articles/journal_contribution/Development_of_Accurate_Forces_for_Mg_sup_2_sup_and_Triphosphate_Interactions_in_ATP_Mg_sup_2_sup_and_GTP_Mg_sup_2_sup_Complexes/27886059", "download_disabled": false, "description": "In\ncells, adenosine triphosphate (ATP) and guanosine triphosphate\n(GTP) molecules typically form tricoordinated or bicoordinated ATP\u00b7Mg<sup>2+</sup> or GTP\u00b7Mg<sup>2+</sup> complexes with Mg<sup>2+</sup> ions and bind to proteins, participating in and regulating many\nimportant cellular functions. The accuracy of their force field parameters\nplays a crucial role in studying the function-related conformations\nof ATP\u00b7Mg<sup>2+</sup> or GTP\u00b7Mg<sup>2+</sup> using molecular\ndynamics (MD) simulations. The parameters developed based on the methyl\ntriphosphate model in existing AMBER force fields cannot accurately\ndescribe the conformational distribution of tricoordinated or bicoordinated\nATP\u00b7Mg<sup>2+</sup> or GTP\u00b7Mg<sup>2+</sup> complexes in\nsolution. In this study, we develop force field parameters for the\ntriphosphate group based on the new ribosyl triphosphate model, considering\nthe dihedral coupling effect, accurate van der Waals (vdW) interactions,\nand the influence of strongly polarized charges on conformational\nbalance. The new force fields can accurately describe the conformational\nbalance of tricoordinated and bicoordinated ATP\u00b7Mg<sup>2+</sup> or GTP\u00b7Mg<sup>2+</sup> conformations in solution and can be\napplied to simulate biological systems containing ATP\u00b7Mg<sup>2+</sup> or GTP\u00b7Mg<sup>2+</sup> complexes.", "funding": null, "funding_list": [], "version": 2, "status": "public", "size": 731088, "created_date": "2024-11-22T14:28:26Z", "modified_date": "2024-11-22T14:28:26Z", "is_public": true, "is_confidential": false, "is_metadata_record": false, "confidential_reason": "", "metadata_reason": "", "license": {"value": 10, "name": "CC BY-NC 4.0", "url": "https://creativecommons.org/licenses/by-nc/4.0/"}, "tags": ["using molecular dynamics", "strongly polarized charges", "parameters developed based", "new force fields", "dihedral coupling effect", "accurate force fields", "triphosphate group based", "methyl triphosphate model", "2 +</ sup", "gtp \u00b7 mg", "atp \u00b7 mg", "guanosine triphosphate", "adenosine triphosphate", "crucial role", "conformational distribution", "conformational balance", "accurately describe"], "keywords": ["using molecular dynamics", "strongly polarized charges", "parameters developed based", "new force fields", "dihedral coupling effect", "accurate force fields", "triphosphate group based", "methyl triphosphate model", "2 +</ sup", "gtp \u00b7 mg", "atp \u00b7 mg", "guanosine triphosphate", "adenosine triphosphate", "crucial role", "conformational distribution", "conformational balance", "accurately describe"], "categories": [{"id": 1, "title": "Biophysics", "parent_id": 48, "path": "", "source_id": "", "taxonomy_id": 10}, {"id": 4, "title": "Biochemistry", "parent_id": 38, "path": "", "source_id": "", "taxonomy_id": 10}, {"id": 915, "title": "Physical Sciences not elsewhere classified", "parent_id": 6, "path": "", "source_id": "", "taxonomy_id": 10}, {"id": 19, "title": "Pharmacology", "parent_id": 48, "path": "", "source_id": "", "taxonomy_id": 10}, {"id": 21, "title": "Biotechnology", "parent_id": 48, "path": "", "source_id": "", "taxonomy_id": 10}, {"id": 873, "title": "Chemical Sciences not elsewhere classified", "parent_id": 38, "path": "", "source_id": "", "taxonomy_id": 10}, {"id": 734, "title": "Biological Sciences not elsewhere classified", "parent_id": 48, "path": "", "source_id": "", "taxonomy_id": 10}, {"id": 133, "title": "Plant Biology", "parent_id": 48, "path": "", "source_id": "", "taxonomy_id": 10}], "references": ["https://doi.org/10.1021/acs.jctc.4c01142"], "has_linked_file": false, "citation": "Hu, Fangchen; Zhang, Yuwei; Li, Pengfei; Wu, Ruibo; Xia, Fei (2024). Development of Accurate Force Fields for Mg2+ and Triphosphate\nInteractions in ATP\u00b7Mg2+ and GTP\u00b7Mg2+ Complexes. ACS Publications. Journal contribution. https://doi.org/10.1021/acs.jctc.4c01142.s001", "related_materials": [{"id": 211279872, "identifier": "10.1021/acs.jctc.4c01142", "title": "Development of\nAccurate Forces for Mg<sup>2+</sup> and Triphosphate Interactions\nin ATP\u00b7Mg<sup>2+</sup> and GTP\u00b7Mg<sup>2+</sup> Complexes", "relation": "IsSupplementTo", "identifier_type": "DOI", "is_linkout": true, "link": "https://doi.org/10.1021/acs.jctc.4c01142"}], "is_embargoed": false, "embargo_date": null, "embargo_type": null, "embargo_title": "", "embargo_reason": "", "embargo_options": [], "id": 27886059, "title": "Development of Accurate Force Fields for Mg<sup>2+</sup> and Triphosphate\nInteractions in ATP\u00b7Mg<sup>2+</sup> and GTP\u00b7Mg<sup>2+</sup> Complexes", "doi": "10.1021/acs.jctc.4c01142.s001", "handle": "", "url": "https://api.figshare.com/v2/articles/27886059", "published_date": "2024-11-22T14:28:26Z", "thumb": "https://s3-eu-west-1.amazonaws.com/ppreviews-acs-4898564/50698206/thumb.png", "defined_type": 6, "defined_type_name": "journal contribution", "group_id": 2421, "url_private_api": "https://api.figshare.com/v2/account/articles/27886059", "url_public_api": "https://api.figshare.com/v2/articles/27886059", "url_private_html": "https://figshare.com/account/articles/27886059", "url_public_html": "https://acs.figshare.com/articles/journal_contribution/Development_of_Accurate_Forces_for_Mg_sup_2_sup_and_Triphosphate_Interactions_in_ATP_Mg_sup_2_sup_and_GTP_Mg_sup_2_sup_Complexes/27886059", "timeline": {"posted": "2024-11-22T14:28:26", "publisherPublication": "2024-11-21T00:00:00", "firstOnline": "2024-11-21"}, "resource_title": "Development of Accurate Force Fields for Mg<sup>2+</sup> and Triphosphate\nInteractions in ATP\u00b7Mg<sup>2+</sup> and GTP\u00b7Mg<sup>2+</sup> Complexes", "resource_doi": "10.1021/acs.jctc.4c01142"}