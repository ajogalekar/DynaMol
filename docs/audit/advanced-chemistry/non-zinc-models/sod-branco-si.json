{"files": [{"id": 4769023, "name": "jp056855l_si_001.pdf", "size": 222162, "is_link_only": false, "download_url": "https://ndownloader.figshare.com/files/4769023", "supplied_md5": "3bd76f82a5d9628ca5119c6144f85f7e", "computed_md5": "3bd76f82a5d9628ca5119c6144f85f7e", "mimetype": "application/pdf"}], "folder_structure": {}, "authors": [{"id": 799058, "full_name": "Ricardo J. F. Branco", "first_name": "Ricardo", "last_name": "J. F. Branco", "is_active": false, "url_name": "_", "orcid_id": ""}, {"id": 472084, "full_name": "Pedro A. Fernandes", "first_name": "Pedro A.", "last_name": "Fernandes", "is_active": false, "url_name": "_", "orcid_id": ""}, {"id": 472085, "full_name": "Maria J. Ramos", "first_name": "Maria J.", "last_name": "Ramos", "is_active": false, "url_name": "_", "orcid_id": ""}], "custom_fields": [], "figshare_url": "https://acs.figshare.com/articles/journal_contribution/Molecular_Dynamics_Simulations_of_the_Enzyme_Cu_Zn_Superoxide_Dismutase/3063247", "download_disabled": false, "description": "The enzyme Cu, Zn superoxide dismutase (Cu,Zn-SOD) is a ubiquitous oxireductase, which is responsible\nfor the cellular defense against oxidative stress caused by the high toxicity of the superoxide radical, and has\nbeen also linked to some cases of familiar amyotrophic lateral sclerosis. In the present study a set of molecular\nmechanics parameters for the active site of Cu,Zn\u2212SOD has been derived. Afterward, an extensive molecular\ndynamics simulation has been carried out in an aqueous environment. The obtained results shed a further\nlight on the structural flexibility of the backbone, where the active site is nested, and the solvation shell\noccupancy. The relatively small backbone deviation, shown by a root-mean-square deviation below 1.0 \u00c5,\nconfirms the accuracy of the parameters. The solvent shell analysis has shown that the first solvation shell is\nlocated at about 5 \u00c5 from the copper ion, generating an empty cavity with enough space to accommodate the\nsuperoxide radical. The low residence time means that a high permutation rate of water molecules in both\nsolvation shells is consistent with the efficiency of this catalytic mechanism. Hybrid studies using ONIOM\nmethodologies can now be done to evaluate the mechanistic implications of the explicit inclusion of the\nwhole system.", "funding": null, "funding_list": [], "version": 1, "status": "public", "size": 222162, "created_date": "2016-02-29T23:21:06Z", "modified_date": "2023-06-07T17:46:22Z", "is_public": true, "is_confidential": false, "is_metadata_record": false, "confidential_reason": "", "metadata_reason": "", "license": {"value": 10, "name": "CC BY-NC 4.0", "url": "https://creativecommons.org/licenses/by-nc/4.0/"}, "tags": ["copper ion", "Molecular Dynamics Simulations", "Zn superoxide dismutase", "site", "shell analysis", "solvation shell occupancy", "water molecules", "backbone deviation", "solvation shell", "Hybrid studies", "permutation rate", "mechanics parameters", "dynamics simulation", "Zn Superoxide DismutaseThe enzyme Cu", "5 \u00c5", "solvation shells", "ONIOM methodologies", "oxidative stress", "Enzyme Cu", "residence time"], "keywords": ["copper ion", "Molecular Dynamics Simulations", "Zn superoxide dismutase", "site", "shell analysis", "solvation shell occupancy", "water molecules", "backbone deviation", "solvation shell", "Hybrid studies", "permutation rate", "mechanics parameters", "dynamics simulation", "Zn Superoxide DismutaseThe enzyme Cu", "5 \u00c5", "solvation shells", "ONIOM methodologies", "oxidative stress", "Enzyme Cu", "residence time"], "categories": [{"id": 1, "title": "Biophysics", "parent_id": 48, "path": "", "source_id": "", "taxonomy_id": 10}, {"id": 4, "title": "Biochemistry", "parent_id": 38, "path": "", "source_id": "", "taxonomy_id": 10}, {"id": 915, "title": "Physical Sciences not elsewhere classified", "parent_id": 6, "path": "", "source_id": "", "taxonomy_id": 10}, {"id": 12, "title": "Cell Biology", "