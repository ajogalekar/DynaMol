# PDB is a fixed-column format; preserve its intentional trailing columns.
*.pdb -whitespace
*.bin binary
*.npz binary
*.png binary

# Preserve exact native-engine audit outputs and their recorded hashes.
docs/audit/preparation-gromacs-probes/** -whitespace
docs/audit/preparation-worker-evidence/** -whitespace
docs/audit/preparation-fixtures/** -whitespace

# Keep downloaded CCD reference records byte-identical to the audit sources.
docs/audit/complex-ccd-*.cif -whitespace
backend/data/modified_residues/*.cif -whitespace
docs/audit/modified-residues/native/** -whitespace
docs/audit/release-readiness/chemistry-inputs/*.cif -whitespace

# Keep pressure-test source structures byte-identical to their recorded hashes.
docs/audit/five-system-pressure-test/*.cif -text -whitespace
docs/audit/five-system-pressure-test/*.pdb -text -whitespace
# Matplotlib SVG paths contain intentional trailing spaces.
docs/audit/five-system-pressure-test/*.svg -text -whitespace
