# Export these before running start.sh if needed.
# DYNAMOL_DATA_DIR=/absolute/path/to/molecular-workspace
# DYNAMOL_CPU_THREADS=2
# DYNAMOL_GMX=/absolute/path/to/gmx
# DYNAMOL_AMBERTOOLS=/absolute/path/to/ambertools
# Native ligand tools default to .tools/ambertools; install with scripts/install_ligand_tools.sh.
# CCD references are cached under DYNAMOL_DATA_DIR/chemistry/ccd.
